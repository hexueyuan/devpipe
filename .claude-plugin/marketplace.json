{
  "name": "devpipe",
  "owner": {
    "name": "He Xueyuan",
    "email": "im.hexueyuan@outlook.com"
  },
  "metadata": {
    "description": "Agentic SDLC skills.",
    "version": "0.0.1"
  },
  "plugins": [
    {
      "name": "devpipe",
      "description": "SDLC工作流：init → discuss → design → coding → review-and-fix → summarize，支持跨对话恢复和 Agent 化子任务执行。",
      "source": "./",
      "strict": false,
      "hooks": {
        "SessionStart": [
          {
            "matcher": "startup|clear|compact",
            "hooks": [
              {
                "type": "command",
                "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/session-start\"",
                "async": false
              }
            ]
          }
        ]
      }
    }
  ]
}
