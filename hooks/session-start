#!/usr/bin/env bash
# SessionStart hook for devpipe plugin
# 在每个会话开始时将 using-devpipe skill 注入到上下文中

set -euo pipefail

# Determine plugin root directory
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Read using-devpipe content
using_devpipe_content=$(cat "${PLUGIN_ROOT}/skills/using-devpipe/SKILL.md" 2>&1 || echo "Error reading using-devpipe skill")

# Escape string for JSON embedding
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

using_devpipe_escaped=$(escape_for_json "$using_devpipe_content")
session_context="\n你已安装 devpipe 工作流插件。\n\n**以下是 devpipe:using-devpipe skill 的完整内容 - 你使用 devpipe skills 的入口调度器。对于具体的阶段 skill（init/discuss/design/coding/review-and-fix/summarize），使用 Skill 工具调用：**\n\n${using_devpipe_escaped}\n"

# Output context injection as JSON
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  printf '{\n  "additional_context": "%s"\n}\n' "$session_context"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"
else
  printf '{\n  "additional_context": "%s"\n}\n' "$session_context"
fi

exit 0
